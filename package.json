{
  "name": "guloxy-mc",
  "version": "1.0.6",
  "description": "Guloxy MC — конструктор сборок Minecraft с модами из CurseForge и Modrinth",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,main,app -c magenta,cyan,green \"vite\" \"node scripts/build-electron.mjs --watch\" \"wait-on tcp:5173 dist-electron/main.cjs && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "web": "vite",
    "build": "tsc -p . && vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrainTX/Guloxy-MC.git"
  },
  "author": "Guloxy",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/FrainTX/Guloxy-MC/issues"
  },
  "homepage": "https://github.com/FrainTX/Guloxy-MC#readme",
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/onest": "^5.3.1",
    "@fontsource/oswald": "^5.3.0",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "adm-zip": "^0.6.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "dompurify": "^3.4.16",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.51.0",
    "marked": "^18.0.14",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "smol-toml": "^1.9.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "undici": "^8.11.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1",
    "zustand": "^5.0.15"
  },
  "productName": "Guloxy MC",
  "build": {
    "appId": "com.guloxy.mc",
    "productName": "Guloxy MC",
    "copyright": "© Guloxy",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Guloxy MC",
      "artifactName": "Guloxy-MC-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png"
    },
    "artifactName": "Guloxy-MC-${version}-${os}-${arch}.${ext}",
    "portable": {
      "artifactName": "Guloxy-MC-Portable-${version}.${ext}"
    }
  }
}
